APP_NAME="AI Lawyer"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ai_lawyer
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=file

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

OPENAI_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview
OPENAI_SUMMARY_MODEL=gpt-4o-mini

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_VALIDATE_SIGNATURE=false

VOICE_GATEWAY_SECRET=
VOICE_GATEWAY_URL=http://127.0.0.1:3100
VOICE_GATEWAY_PUBLIC_WS_URL=

# Telnyx (optional — search / buy numbers, then attach to Synthflow)
TELNYX_API_KEY=
TELNYX_CONNECTION_ID=
TELNYX_DEFAULT_COUNTRY=US

# Synthflow Platform API (inbound voice agents + custom booking actions)
# Dashboard: https://app.synthflow.ai — API key + workspace id from Settings
SYNTHFLOW_API_KEY=
SYNTHFLOW_WORKSPACE_ID=
SYNTHFLOW_API_BASE=https://api.synthflow.ai/v2
SYNTHFLOW_LLM=gpt-4.1-mini
# Existing inbound agent to attach (do not create a second one)
SYNTHFLOW_AGENT_NAME="Qubetech AI Lawyer"
SYNTHFLOW_AGENT_PHONE=+16097809610
SYNTHFLOW_AGENT_ID=
# Legacy aliases (optional — SYNTHFLOW_* preferred)
FINETUNER_API_KEY=
FINETUNER_WORKSPACE_ID=
FINETUNER_API_BASE=https://api.synthflow.ai/v2

# CourtListener — US case law (server-side only; never expose token to browser/JS/logs)
# Free token: https://www.courtlistener.com/profile/api-tokens/
COURTLISTENER_ENABLED=false
COURTLISTENER_API_TOKEN=
COURTLISTENER_BASE_URL=https://www.courtlistener.com/api/rest/v4
COURTLISTENER_TIMEOUT=30
COURTLISTENER_DEFAULT_COURT=scotus
COURTLISTENER_MAX_PER_MINUTE=5
COURTLISTENER_MAX_PER_HOUR=100
COURTLISTENER_MAX_PER_DAY=500
# Legacy aliases still read by config/services.php for the older LegalDataProvider path:
COURTLISTENER_CACHE_TTL=3600
COURTLISTENER_STALE_TTL=86400
COURTLISTENER_REQUESTS_PER_MINUTE=5

# Anthropic — case-law AI extraction (server-side only)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Find Case Law (UK National Archives) — requires computational analysis licence for bulk use
# Public Atom API under Open Justice Licence (not bulk computational analysis)
FINDCASELAW_ENABLED=true
FINDCASELAW_BASE_URL=https://caselaw.nationalarchives.gov.uk

# CanLII (Canada) — optional legacy path; prefer CANADA_CASES_API_URL (A2AJ, no key)
CANLII_API_KEY=
CANLII_LANGUAGE=en
CANLII_CA_FED_DATABASES=csc-scc,fca,fc
CANLII_CA_ON_DATABASES=onca,onsc

# A2AJ Canadian Legal Data API (free, no key) — used for CA-FED / CA-ON fetches
CANADA_CASES_API_URL=https://api.a2aj.ca
CANADA_CASES_LANGUAGE=en
CANADA_CASES_DEFAULT_QUERY=v
CANADA_CASES_CA_FED_DATASETS=SCC,FCA,FC
CANADA_CASES_CA_ON_DATASETS=ONCA

# Federal Court of Australia judgments RSS — used for AU-FED fetches
AUSTRALIA_CASES_API_URL=https://www.judgments.fedcourt.gov.au/rss/fca-judgments

# Case-law fetch schedule + politeness defaults
CASE_LAW_FETCH_SCHEDULE_ENABLED=false
CASE_LAW_FETCH_DELAY_MS=2500
CASE_LAW_FETCH_USER_AGENT="AI-Lawyer/1.0 (+https://example.local; research)"
CASE_LAW_FETCH_MAX_REQUESTS=25
CASE_LAW_FETCH_RESPECT_ROBOTS=true

SINDH_CASELAW_BASE_URL=https://caselaw.shc.gov.pk
PAKISTAN_CASE_LAW_MCP_URL=https://pakistancaselaw.com/mcp

# Stripe (dummy credentials for local checkout)
STRIPE_MODE=dummy
STRIPE_KEY=pk_test_dummy
STRIPE_SECRET=sk_test_dummy
STRIPE_WEBHOOK_SECRET=whsec_dummy
STRIPE_CURRENCY=usd

# Stripe Recurring Price IDs
STRIPE_PRICE_STARTER_MONTHLY=price_starter_monthly
STRIPE_PRICE_STARTER_YEARLY=price_starter_yearly
STRIPE_PRICE_GROWTH_MONTHLY=price_growth_monthly
STRIPE_PRICE_GROWTH_YEARLY=price_growth_yearly
STRIPE_PRICE_PILOT_YEARLY=price_pilot_yearly
STRIPE_PILOT_CHECKOUT_ENABLED=false
